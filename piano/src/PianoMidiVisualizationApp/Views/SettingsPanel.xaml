<UserControl x:Class="PianoMidiVisualizationApp.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings > devices, audio engine, and soundbank library. Structured into two aligned
         columns: MIDI & Audio on the left (fixed 88px label column + aligned controls), and the
         managed Soundbank Library on the right for one-click switching between .sf2/.sfz pianos. -->
    <UserControl.Resources>
        <Style x:Key="Style.SettingsSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Style.SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <DataTemplate x:Key="Template.SoundBankComboItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                        Background="{StaticResource Brush.SurfaceRaised}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Data}"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SurfaceAlt}" Padding="20,14,44,12">
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="564"/>
                <ColumnDefinition Width="436"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Column 0: MIDI & Audio Engine ================= -->
            <Grid Grid.Column="0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="MIDI &amp; audio" Style="{StaticResource Style.SettingsSectionHeader}"/>

                <!-- Row 1: Keyboard -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Keyboard" Style="{StaticResource Style.SettingsLabel}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="190" Height="26"
                              ItemsSource="{Binding Settings.MidiDevices}"
                              SelectedItem="{Binding Settings.SelectedMidiDevice}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="MIDI keyboard"/>
                    <!-- Show Connect when NOT connected -->
                    <Button Content="Connect" Width="88" Height="26" Margin="6,0,0,0" Padding="10,0"
                            Command="{Binding ConnectMidiCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMidiConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Show Disconnect when connected -->
                    <Button Content="Disconnect" Width="88" Height="26" Margin="6,0,0,0" Padding="10,0"
                            Command="{Binding DisconnectMidiCommand}"
                            Visibility="{Binding IsMidiConnected, Converter={StaticResource BoolToVisConverter}}"/>
                    <!-- MIDI activity indicator -->
                    <Ellipse Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center"
                             ToolTip="{Binding LastMidiMessage}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Midi.Idle}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMidiConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Midi.Connected}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MidiActivity}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Midi.Active}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Button Content="&#xE72C;" Width="26" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource Style.GlyphButton}"
                            Command="{Binding RefreshDeviceListCommand}"
                            ToolTip="Look again for keyboards and audio outputs"
                            AutomationProperties.Name="Look again for devices"/>
                </StackPanel>

                <!-- Row 2: Output -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Output" Style="{StaticResource Style.SettingsLabel}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="ASIO" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                                 IsChecked="{Binding Settings.UseAsio}" GroupName="AudioMode" Margin="0,0,10,0"
                                 ToolTip="Lowest latency. Needs an ASIO driver, e.g. your interface's or ASIO4ALL."/>
                    <RadioButton Content="WASAPI" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                                 IsChecked="{Binding Settings.UseAsio, Converter={StaticResource InverseBoolConverter}}"
                                 GroupName="AudioMode" Margin="0,0,10,0"
                                 ToolTip="Windows' own audio. Works everywhere, with a little more latency."/>
                    <!-- ASIO drivers shown when ASIO selected -->
                    <ComboBox Width="190" Height="26"
                              ItemsSource="{Binding Settings.AsioDriverNames}"
                              SelectedItem="{Binding Settings.SelectedAudioDriver}"
                              AutomationProperties.Name="ASIO driver"
                              Visibility="{Binding Settings.UseAsio, Converter={StaticResource BoolToVisConverter}}"/>
                    <!-- WASAPI devices shown when WASAPI selected -->
                    <ComboBox Width="190" Height="26"
                              ItemsSource="{Binding Settings.WasapiDeviceNames}"
                              SelectedItem="{Binding Settings.SelectedAudioDriver}"
                              AutomationProperties.Name="Audio device">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.UseAsio}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <Button Content="Start audio" Width="88" Height="26" Margin="6,0,0,0" Padding="10,0"
                            Style="{StaticResource Style.PrimaryButton}"
                            Command="{Binding StartAudioCommand}"
                            IsEnabled="{Binding IsAudioRunning, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Stop" Width="54" Height="26" Margin="6,0,0,0" Padding="10,0"
                            Command="{Binding StopAudioCommand}"
                            IsEnabled="{Binding IsAudioRunning}"
                            ToolTip="Stop audio"/>
                </StackPanel>

                <!-- Row 3: Levels & AI -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Volume" Style="{StaticResource Style.SettingsLabel}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding Settings.Volume}"
                            VerticalAlignment="Center" TickFrequency="0.1"
                            AutomationProperties.Name="Volume"/>
                    <TextBlock Text="Click" Style="{StaticResource Style.SettingsLabel}" Margin="16,0,8,0"/>
                    <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Settings.MetronomeVolume}"
                            VerticalAlignment="Center" TickFrequency="0.1"
                            ToolTip="Metronome volume, relative to the master volume"
                            AutomationProperties.Name="Metronome volume"/>
                    <TextBlock Text="Gemini key" Style="{StaticResource Style.SettingsLabel}" Margin="16,0,8,0"/>
                    <PasswordBox x:Name="ApiKeyBox" Width="148" Height="26"
                                 PasswordChanged="ApiKeyBox_PasswordChanged"
                                 AutomationProperties.Name="Google Gemini API key"
                                 ToolTip="Your Google Gemini API key, for the AI Music Assistant. Your messages, the chord you hold, the key and your progression are sent to Google."/>
                </StackPanel>
            </Grid>

            <!-- ================= Column 1: Soundbank Library ================= -->
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16,0,0,0"
                    BorderBrush="{StaticResource Brush.Separator}" BorderThickness="1,0,0,0"
                    DataContext="{Binding Settings}">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row: Title + Import / Remove actions -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Soundbank Library"
                                   Style="{StaticResource Style.SettingsSectionHeader}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Import .sf2 / .sfz…" Height="24" Padding="10,0"
                                    Command="{Binding ImportSoundBanksCommand}"
                                    ToolTip="Import one or more SoundFont (.sf2) or SFZ (.sfz) piano soundbanks into your library"/>
                            <Button Content="Remove" Height="24" Padding="10,0" Margin="6,0,0,0"
                                    Command="{Binding RemoveSoundBankCommand}"
                                    CommandParameter="{Binding SelectedSoundBank}"
                                    IsEnabled="{Binding HasSelectedSoundBank}"
                                    ToolTip="Remove the selected soundbank from your library"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Active soundbank selector -->
                    <ComboBox Grid.Row="2" Height="26"
                              ItemsSource="{Binding SoundBanks}"
                              SelectedItem="{Binding SelectedSoundBank}"
                              ItemTemplate="{StaticResource Template.SoundBankComboItem}"
                              Tag="No piano soundbank — click Import .sf2 / .sfz…"
                              ToolTip="{Binding SoundFontPath}"
                              AutomationProperties.Name="Piano sound file"/>

                    <!-- Compact scrollable soundbank list for one-click switching -->
                    <Grid Grid.Row="4" MinHeight="64" MaxHeight="84">
                        <ListBox ItemsSource="{Binding SoundBanks}"
                                 SelectedItem="{Binding SelectedSoundBank, Mode=TwoWay}"
                                 Background="{StaticResource Brush.Input.Well}"
                                 BorderBrush="{StaticResource Brush.Input.WellRim}"
                                 BorderThickness="1"
                                 Padding="2"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Imported piano soundbanks">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Padding" Value="8,2,4,2"/>
                                    <Setter Property="Margin" Value="0,0,0,1"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="3"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Selected}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding FilePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Midi.Idle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Status.Ok}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="2" Margin="8,0,4,0" Padding="5,0" CornerRadius="2.5"
                                                Background="{StaticResource Brush.SurfaceRaised}"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource Font.Data}"
                                                       Foreground="{StaticResource Brush.Text.Muted}"/>
                                        </Border>

                                        <Button Grid.Column="3" Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                Style="{StaticResource Style.RemoveGlyphButton}"
                                                Focusable="False"
                                                Command="{Binding DataContext.RemoveSoundBankCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove soundbank from library"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Import .sf2 or .sfz soundbanks to switch pianos with one click"
                                   FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSoundBanks}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
